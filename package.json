{
  "name": "@openverb/geostory",
  "version": "0.3.0",
  "description": "GeoStory profile for OpenVerb \u2014 a portable geographic narrative format (.ov)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": "./schema/geostory-1.0.schema.json",
    "./spec": "./spec/geostory-profile-1.0.md",
    "./examples/*": "./examples/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/",
    "src/types.ts",
    "src/verbs/",
    "schema/geostory-1.0.schema.json",
    "spec/geostory-profile-1.0.md",
    "examples/"
  ],
  "scripts": {
    "build": "tsc && node scripts/emit-schema.js",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "openverb",
    "geostory",
    "gis",
    "geospatial",
    "narrative",
    "storytelling",
    "workflow",
    "ov"
  ],
  "author": "Roman Hancel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgthancel/openverb-geostory.git"
  },
  "dependencies": {
    "@openverb/format": "^2.0.0-beta.3",
    "ajv": "^8.17.1",
    "js-yaml": "^4.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@openverb/runtime": "2.0.0-alpha.6"
  },
  "peerDependenciesMeta": {
    "@openverb/runtime": {
      "optional": true
    }
  },
  "homepage": "https://github.com/sgthancel/openverb-geostory#readme",
  "bugs": {
    "url": "https://github.com/sgthancel/openverb-geostory/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
