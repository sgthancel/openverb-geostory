{
  "name": "@openverb/geostory",
  "version": "0.1.0",
  "description": "GeoStory profile for OpenVerb — a portable geographic narrative format (.ov)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "src/verbs/",
    "schema/geostory-1.0.schema.json"
  ],
  "scripts": {
    "build": "tsc && node scripts/emit-schema.js",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openverb",
    "geostory",
    "gis",
    "geospatial",
    "narrative",
    "storytelling",
    "workflow",
    "ov"
  ],
  "author": "Roman Hancel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sgthancel/openverb-geostory"
  },
  "dependencies": {
    "@openverb/format": "^2.0.0-beta.3",
    "ajv": "^8.17.1",
    "js-yaml": "^4.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@openverb/runtime": "2.0.0-alpha.6"
  },
  "peerDependenciesMeta": {
    "@openverb/runtime": {
      "optional": true
