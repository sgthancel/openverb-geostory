name: history-of-coffee
version: 1.0.0
profile: geostory
description: Coffee's route out of the Ethiopian highlands and around the world

# -----------------------------------------------------------------------------
# Ten beats, each carrying the words it is meant to say.
#
# This file used to hold twenty-five scenes and eleven words of
# narration between them - three minutes of story that no player could
# voice, because the text was never there. Length is not substance.
#
# The audio registry names recordings that do not ship with this repo.
# That is deliberate and it is allowed: every clip also carries its
# text, so a player with no files can still speak the story. Compare
# iceland-still-building.ov, which names no files at all.
# -----------------------------------------------------------------------------

story:
  title: "The History of Coffee"
  author: "GeoStudio Narrative Team"
  crs: "EPSG:4326"
  created: "2026-08-20T10:00:00Z"
  tags: ["history", "coffee", "trade", "global"]

# A field no version of the schema mentions. It is here on purpose: a
# conforming parser must preserve what it does not recognise, and this
# is what tests that rule.
custom_studio_workspace: "coffee_project_v2"

extensions:
  qgis:
    project: "./coffee-history.qgz"
    render_crs: "EPSG:3857"
    export_resolution: "1080p"

settings:
  default_basemap: carto-dark
  default_duration: 10
  default_transition: fly
  loop: false

basemaps:
  - id: carto-dark
    name: "CartoDB Dark Matter"
    type: xyz
    url: "https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png"
    max_zoom: 20
    attribution: "© OpenStreetMap contributors © CARTO"

  - id: arcgis-satellite
    name: "Esri World Imagery"
    type: xyz
    url: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
    max_zoom: 19
    attribution: "© Esri, Maxar, Earthstar Geographics"

places:
  - id: pl_ethiopia
    as_written: "Ethiopia"
    resolved:
      name: "Ethiopia"
      point: [40.48, 9.14]
      bounds: [[32.99, 3.39], [47.98, 14.89]]
      kind: country
      provider: nominatim
      resolved_at: "2026-08-20T10:00:00Z"
      confidence: 0.95

  - id: pl_mocha
    as_written: "Mocha, Yemen"
    resolved:
      name: "Mocha"
      point: [43.24, 13.31]
      bounds: [[43.22, 13.29], [43.26, 13.33]]
      kind: city
      provider: nominatim
      resolved_at: "2026-08-20T10:00:00Z"
      confidence: 0.92

  - id: pl_istanbul
    as_written: "Constantinople"
    resolved:
      name: "Istanbul, Turkey"
      point: [28.97, 41.0]
      bounds: [[28.6, 40.8], [29.3, 41.2]]
      kind: city
      provider: nominatim
      resolved_at: "2026-08-20T10:00:00Z"
      confidence: 0.98

  - id: pl_venice
    as_written: "Venice"
    resolved:
      name: "Venice, Italy"
      point: [12.31, 45.44]
      bounds: [[12.2, 45.3], [12.45, 45.6]]
      kind: city
      provider: nominatim
      resolved_at: "2026-08-20T10:00:00Z"
      confidence: 0.95

  - id: pl_vienna
    as_written: "Vienna"
    resolved:
      name: "Vienna, Austria"
      point: [16.37, 48.2]
      bounds: [[16.18, 48.11], [16.57, 48.32]]
      kind: city
      provider: nominatim
      resolved_at: "2026-08-20T10:00:00Z"
      confidence: 0.96

  - id: pl_london
    as_written: "London"
    resolved:
      name: "London, UK"
      point: [-0.12, 51.5]
      bounds: [[-0.51, 51.28], [0.33, 51.69]]
      kind: city
      provider: nominatim
      resolved_at: "2026-08-20T10:00:00Z"
      confidence: 0.99

  - id: pl_martinique
    as_written: "Martinique"
    resolved:
      name: "Martinique"
      point: [-61.02, 14.64]
      bounds: [[-61.23, 14.38], [-60.78, 14.88]]
      kind: natural
