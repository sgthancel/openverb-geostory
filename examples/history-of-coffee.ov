      confidence: 0.9

  - id: pl_brazil
    as_written: "Brazil"
    resolved:
      name: "Brazil"
      point: [-51.93, -14.24]
      bounds: [[-73.99, -33.75], [-34.79, 5.27]]
      kind: country
