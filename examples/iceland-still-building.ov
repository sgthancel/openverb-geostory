      name: "Krafla, Iceland"
      point: [-16.78, 65.72]
      bounds: [[-16.90, 65.66], [-16.66, 65.78]]
      kind: natural
      provider: nominatim
      resolved_at: "2026-08-20T00:00:00Z"
      confidence: 0.92

  - id: pl_vatnajokull
    as_written: "Vatnajökull"
    resolved:
      name: "Vatnajökull, Iceland"
      point: [-16.8, 64.4]
      bounds: [[-18.2, 63.95], [-15.5, 64.85]]
      kind: natural
      provider: nominatim
      resolved_at: "2026-08-20T00:00:00Z"
      confidence: 0.94

  - id: pl_grimsvotn
    as_written: "Grímsvötn"
    resolved:
      name: "Grímsvötn, Iceland"
      point: [-17.33, 64.42]
      bounds: [[-17.45, 64.37], [-17.20, 64.47]]
