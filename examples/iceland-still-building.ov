      provider: nominatim
      resolved_at: "2026-08-20T00:00:00Z"
      confidence: 0.90

  - id: pl_eyjafjallajokull
    as_written: "Eyjafjallajökull"
    resolved:
      name: "Eyjafjallajökull, Iceland"
      point: [-19.62, 63.63]
      bounds: [[-19.80, 63.57], [-19.42, 63.69]]
