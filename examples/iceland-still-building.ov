name: iceland-still-building
version: 1.0.0
profile: geostory
description: A country being built in real time, told along the Mid-Atlantic Ridge

# ─────────────────────────────────────────────────────────────────────────────
# This document carries everything it needs and points at nothing outside
# itself. No .wav files, no images, no data layers - just words, coordinates,
# and the tile servers to draw them on.
#
# That is the shape a GeoStory should usually take. Narration lives in
# scenes[].content.narration as text, and whoever plays the document speaks it.
# A recording is an optimisation - useful when a human voiced it, or when the
# exact performance matters - not a requirement, and a document that names
# .wav files it cannot guarantee will travel is a document that plays silent
# on someone else's machine.
#
# Load this into the GeoStudio plugin with "Generate narration" ticked and it
# renders complete: camera, captions, basemaps and a voice, from this file
# alone.
# ─────────────────────────────────────────────────────────────────────────────

story:
  title: "Iceland: A Country Still Being Built"
  author: "GeoStudio"
  crs: "EPSG:4326"
  tags: ["iceland", "geology", "volcano", "plate tectonics"]

settings:
  default_basemap: bm_dark
  default_duration: 9
  default_transition: fly
  loop: false

# ─── BASEMAPS ────────────────────────────────────────────────────────────────
# Declared rather than named, so a reader that has never heard of "bm_dark"
# can still draw it and still credit it correctly.

basemaps:
  - id: bm_dark
    name: "CartoDB Dark Matter"
    type: xyz
    url: "https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png"
    max_zoom: 20
    attribution: "© OpenStreetMap contributors © CARTO"

  - id: bm_terrain
    name: "OpenTopoMap"
    type: xyz
    url: "https://tile.opentopomap.org/{z}/{x}/{y}.png"
    max_zoom: 17
    attribution: "© OpenStreetMap contributors, SRTM | © OpenTopoMap (CC-BY-SA)"

  - id: bm_satellite
    name: "Esri World Imagery"
    type: xyz
    url: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
    max_zoom: 19
    attribution: "© Esri, Maxar, Earthstar Geographics"

# ─── PLACES ──────────────────────────────────────────────────────────────────
# Geocoding is an authoring step. These were resolved once, written down, and
# are never looked up again at playback.

places:
  - id: pl_iceland
    as_written: "Iceland"
    resolved:
      name: "Iceland"
      point: [-19.0, 64.9]
      bounds: [[-24.6, 63.3], [-13.5, 66.6]]
      kind: country
      provider: nominatim
      resolved_at: "2026-08-20T00:00:00Z"
      confidence: 0.98

  - id: pl_thingvellir
    as_written: "Þingvellir"
    resolved:
      name: "Þingvellir National Park, Iceland"
      point: [-21.13, 64.255]
      bounds: [[-21.22, 64.22], [-21.02, 64.30]]
      kind: landmark
      provider: nominatim
      resolved_at: "2026-08-20T00:00:00Z"
      confidence: 0.95

  - id: pl_reykjavik
    as_written: "Reykjavík"
    resolved:
      name: "Reykjavík, Iceland"
      point: [-21.94, 64.146]
      bounds: [[-22.05, 64.09], [-21.75, 64.18]]
      kind: city
      provider: nominatim
      resolved_at: "2026-08-20T00:00:00Z"
      confidence: 0.97

  - id: pl_krafla
    as_written: "Krafla"
