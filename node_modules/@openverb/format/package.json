{
  "name": "@openverb/format",
  "version": "2.0.0-beta.3",
  "description": "OpenVerb document format (.ov) parser, validator, and runtime bridge",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "ajv": "^8.12.0",
    "yaml": "^2.3.4",
    "@openverb/runtime": "2.0.0-beta.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  },
  "keywords": [
    "openverb",
    "ov",
    "format",
    "parser",
    "yaml",
    "automation"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "lint": "eslint src/",
    "test": "vitest run"
  }
}